FAILURELENS_DATABASE_URL=postgresql+psycopg://failurelens:failurelens@db:5432/failurelens
FAILURELENS_ARTIFACT_ROOT=/var/lib/failurelens/artifacts
FAILURELENS_DEMO_MODE=true
FAILURELENS_INGESTION_TOKEN=replace-with-a-long-random-token
FAILURELENS_MAX_FILE_BYTES=52428800
FAILURELENS_MAX_BUNDLE_BYTES=262144000
FAILURELENS_MAX_EXPANDED_BYTES=524288000
FAILURELENS_MAX_ARCHIVE_ENTRIES=2000
FAILURELENS_MAX_COMPRESSION_RATIO=100
FAILURELENS_JOB_LEASE_SECONDS=60
FAILURELENS_JOB_MAX_ATTEMPTS=3
