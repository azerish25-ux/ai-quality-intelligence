FAILURELENS_DATABASE_URL=postgresql+psycopg://failurelens:failurelens@db:5432/failurelens
FAILURELENS_ARTIFACT_ROOT=/var/lib/failurelens/artifacts
FAILURELENS_EVALUATION_METRICS_PATH=/app/evaluation/reports/ledgerguard-component-v1-7405d923/metrics.json

# The supplied Compose stack is a loopback-bound synthetic demo.
FAILURELENS_DEMO_MODE=true
FAILURELENS_SESSION_COOKIE_NAME=failurelens_session
FAILURELENS_SESSION_TTL_HOURS=12
FAILURELENS_SESSION_COOKIE_SECURE=false

# Required when FAILURELENS_DEMO_MODE=false. Use HTTPS and a unique password.
FAILURELENS_BOOTSTRAP_ADMIN_USERNAME=
FAILURELENS_BOOTSTRAP_ADMIN_PASSWORD=
FAILURELENS_BOOTSTRAP_ADMIN_DISPLAY_NAME=FailureLens Administrator

FAILURELENS_MAX_FILE_BYTES=52428800
FAILURELENS_MAX_BUNDLE_BYTES=262144000
FAILURELENS_MAX_EXPANDED_BYTES=524288000
FAILURELENS_MAX_ARCHIVE_ENTRIES=2000
FAILURELENS_MAX_COMPRESSION_RATIO=100
FAILURELENS_MAX_IMAGE_PIXELS=25000000
FAILURELENS_ANALYSIS_TEXT_BUDGET=40000
FAILURELENS_JOB_LEASE_SECONDS=60
FAILURELENS_JOB_MAX_ATTEMPTS=3
